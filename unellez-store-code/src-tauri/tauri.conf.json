{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unellez-store",
  "version": "1.0.0",
  "identifier": "com.unellez.store",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "unellez-store",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
     "publisher": "Gustavo Barreto / GUSB Works", 
	 "copyright": "© 2026 Gustavo Barreto / GUSB Works - Liberado bajo licencia GNU GPLv3", 
	 "shortDescription": "Tienda de software oficial para Canaima Sabor UNELLEZ", 
	 "category": "Utility" 
 } 
}
